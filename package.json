{
  "name": "quadra-5.0-tournament",
  "version": "1.0.0",
  "description": "QUADRA 5.0 - Intercollegiate Sports Tournament Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "postinstall": "cd client && npm install --include=dev && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "sql.js": "^1.14.1",
    "sqlite3": "^6.0.1"
  },
  "keywords": [
    "tournament",
    "sports",
    "live-scores",
    "quadra"
  ],
  "author": "QUADRA 5.0 Team",
  "license": "MIT"
}
